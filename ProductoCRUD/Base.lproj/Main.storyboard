                                    <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                </state>
                                <connections>
                                    <action selector="editarTapped:" destination="det-pro-vc" eventType="touchUpInside" id="btn-edit-action"/>
                                </connections>
                            </button>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="det-safe-area"/>
                        <color key="backgroundColor" red="0.95686274510000002" green="0.96470588239999999" blue="0.97647058819999999" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="det-logo" firstAttribute="centerX" secondItem="det-bg-view" secondAttribute="centerX" id="c-det-logo-cx"/>
                            <constraint firstItem="det-logo" firstAttribute="top" secondItem="det-safe-area" secondAttribute="top" constant="56" id="t-det-logo-t"/>
                            <constraint firstItem="det-safe-area" firstAttribute="trailing" secondItem="det-card" secondAttribute="trailing" constant="30" id="r-det-card-r"/>
                            <constraint firstItem="det-card" firstAttribute="leading" secondItem="det-safe-area" secondAttribute="leading" constant="30" id="l-det-card-l"/>
                            <constraint firstItem="det-card" firstAttribute="top" secondItem="det-logo" secondAttribute="bottom" constant="40" id="t-det-card-t"/>
                            <constraint firstItem="det-safe-area" firstAttribute="trailing" secondItem="det-btn-editar" secondAttribute="trailing" constant="30" id="r-btn-e-r"/>
                            <constraint firstItem="det-btn-editar" firstAttribute="leading" secondItem="det-safe-area" secondAttribute="leading" constant="30" id="l-btn-e-l"/>
                            <constraint firstItem="det-btn-editar" firstAttribute="top" secondItem="det-card" secondAttribute="bottom" constant="50" id="t-btn-e-t"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" title="Detalle del Producto" id="det-nav-item"/>
