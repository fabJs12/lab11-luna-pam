                                    <constraint firstItem="det-lbl-categoria" firstAttribute="leading" secondItem="det-card" secondAttribute="leading" constant="20" id="l-det-l-c-l"/>
                                    <constraint firstItem="det-lbl-categoria" firstAttribute="top" secondItem="det-lbl-stock" secondAttribute="bottom" constant="30" id="t-det-l-c-t"/>
                                    <constraint firstAttribute="height" constant="240" id="h-det-card-h"/>
                                </constraints>
                            </view>
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="det-btn-editar">
                                <rect key="frame" x="30" y="530" width="354" height="50"/>
                                <color key="backgroundColor" red="0.0" green="0.29411764709999999" blue="0.52941176469999995" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="50" id="h-btn-e-h"/>
                                </constraints>
                                <fontDescription key="fontDescription" type="boldSystem" pointSize="18"/>
