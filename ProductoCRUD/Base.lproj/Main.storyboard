                            <constraint firstItem="edi-tf-nombre" firstAttribute="leading" secondItem="edi-safe-area" secondAttribute="leading" constant="30" id="l-edi-tf-n-l"/>
                            <constraint firstItem="edi-tf-nombre" firstAttribute="top" secondItem="edi-safe-area" secondAttribute="top" constant="56" id="t-edi-tf-n-t"/>
